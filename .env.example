# Copy to .env (scripts/setup_lab.sh does this). .env is git-ignored; do not put keys in the YAML configs.

# Default backend: every agent and experiment LLM call goes to a Cursor model through the Cursor CLI.
# Create a key at https://cursor.com/dashboard -> Integrations -> API Keys (or run `agent login` once instead).
CURSOR_API_KEY=
# Model slug from `agent --list-models`; leave empty for your account's default model.
CURSOR_MODEL=claude-opus-5-5
# Simultaneous Cursor calls per process (generated experiment code parallelizes its queries).
CURSOR_MAX_CONCURRENCY=4

# Set LAB_BACKEND=upstream to use upstream's OpenAI / DeepSeek API calls instead.
LAB_BACKEND=cursor
OPENAI_API_KEY=
DEEPSEEK_API_KEY=

# Optional
HF_TOKEN=
